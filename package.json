{
  "name": "capacitor-token-vault",
  "version": "0.1.0",
  "description": "Capacitor plugin that keeps auth tokens in iOS Keychain, Android Keystore, and sessionStorage on the web. Zero runtime dependencies.",
  "author": "AfanasievN (https://github.com/AfanasievN)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfanasievN/capacitor-token-vault.git"
  },
  "bugs": {
    "url": "https://github.com/AfanasievN/capacitor-token-vault/issues"
  },
  "homepage": "https://github.com/AfanasievN/capacitor-token-vault#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "Package.swift",
    "android/src/main/",
    "android/build.gradle",
    "CapacitorTokenVault.podspec",
    "docs/",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "keychain",
    "keystore",
    "secure-storage",
    "token",
    "auth",
    "refresh-token",
    "ios",
    "android",
    "owasp",
    "masvs",
    "zero-dependencies"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
